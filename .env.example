# Copy this file to `.env` and fill in what you need.
# `.env` is gitignored — never commit a real key.
#
# Everything here is OPTIONAL. With no keys at all the site works exactly as it
# does now: the title generators use the built-in template engine.

# ---------------------------------------------------------------------------
# Model provider — set ONE of these to switch the title generators to AI.
# The first one found (in this order) is used. Never add a VITE_ prefix: that
# prefix is what marks a variable for the browser bundle.
# ---------------------------------------------------------------------------

# Paid. https://console.anthropic.com — a Claude Pro/Max subscription does NOT
# include API credits; those are billed separately.
ANTHROPIC_API_KEY=

# Free tier available. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free tier available. https://console.groq.com/keys
GROQ_API_KEY=

# Paid. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Has some free models. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://console.mistral.ai
MISTRAL_API_KEY=

# Override the model for whichever provider is selected. Model names change
# faster than this repo does, so a retired model is a config fix, not a code fix.
LLM_MODEL=

# ---------------------------------------------------------------------------
# Analytics — leave unset and no analytics script loads at all.
# ---------------------------------------------------------------------------
VITE_GA_ID=
